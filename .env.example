# Copia este archivo como .env.local para probar en tu computadora.
# En Vercel se ponen en: Project → Settings → Environment Variables.

# Correo real del demo de Agenda (https://resend.com → API Keys)
RESEND_API_KEY=
# Remitente. El dominio debe estar verificado en Resend.
RESEND_FROM_EMAIL="Solvera Labs Demos <demos@solveralabs.ai>"

# WhatsApp real del demo de Agenda: liga del webhook (Make u otro) que dispara
# la plantilla aprobada de WhatsApp. Recibe los datos de la cita y "whatsappNumber" (521 + 10 dígitos).
WHATSAPP_DEMO_WEBHOOK_URL=

# Número de WhatsApp de Solvera para el botón "Probar conversación en mi WhatsApp"
NEXT_PUBLIC_SOLVERA_WA_NUMBER=5213310742087
